# -*- coding: utf-8 -*-
# ARKHIV_KHRANITEL_V1 — рабочий движок поста «хранитель архива»
"""
ХРАНИТЕЛЬ АРХИВА · рабочий движок

Это РОЛЬ, не человек — тот же закон, что у bibliotekar.py (Академия).
Файл не знает и не хочет знать, кто на посту. Личность приходит извне —
из паспорта того, кого посадили на пост (ГОРОД/rezidenty.py ->
lichnost_na_postu). Сейчас на посту Лока, но движок об этом ни строчки
не знает — посади другого, голос будет другой.

Что умеет Хранитель:
  • искать записи в архиве — по названию, разделу, тегам
  • сказать честно, что в архиве есть, а чего нет
  • дать оценку без жалости: «это живое или пластик?» — по закону
    Архива (честность выше комфорта, детали важнее скорости)
  • когда в архиве пусто по запросу — выйти на Маяк за внешним миром
  • говорить в чате — с Шефом, в роли Хранителя

Записи читаются с диска, каталог свой — Архив не делит полки с
Академией (GRONDHEIM_CITY/Архив/архив/каталог.json). Второго реестра
нет, второй каталог не заводим.

ЧЕГО ЗДЕСЬ НЕТ ЧЕСТНО: движок не выдумывает записей, которых нет.
Раздел пуст — так и скажет.

`шесть·проверено·до·корня`
"""
import json
import os
import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent     # Архив/
_REPO = _HERE.parent                         # корень репо
for _p in (_REPO, _REPO / "ГОРОД", _HERE):
    if str(_p) not in sys.path:
        sys.path.insert(0, str(_p))

POST_ID = "khranitel_arkhiva"                # id поста в реестре города

_ARKHIV = _REPO / "GRONDHEIM_CITY" / "Архив" / "архив"
_KATALOG = _ARKHIV / "каталог.json"

RAZDELY = ["документы", "чертежи", "переписка", "медиа", "прочее"]


# ═══════════════════════════════════════════════════════════
# СТЕЛЛАЖИ (разделы архива)
# ═══════════════════════════════════════════════════════════

def _read_json(p: Path, default=None):
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return default


def vse_zapisi() -> list:
    """Все записи каталога. Каталога нет — пустой список, не падаем."""
    k = _read_json(_KATALOG, {}) or {}
    return k.get("записи", []) or []


def razdely_svodka() -> dict:
    """Сколько записей в каком разделе. {раздел: число}."""
    out = {}
    for z in vse_zapisi():
        r = z.get("раздел", "прочее")
        out[r] = out.get(r, 0) + 1
    return out


def nayti_zapisi(zapros: str, razdel: str = "", limit: int = 8) -> list:
    """Поиск записей по названию, тегам и разделу. Пустой запрос —
    первые из выбранного раздела (или вообще первые).

    Ищем честно: подстрокой, без выдумок. Не нашли — пустой список.
    """
    q = (zapros or "").strip().lower()
    out = []
    for z in vse_zapisi():
        if razdel and z.get("раздел", "") != razdel:
            continue
        if q:
            # PATCH_ARKHIV_KATALOG_PERSIST_V1: описание тоже участвует в
            # поиске -- иначе разбор картинки (лежит именно там) никогда
            # не найдётся текстовым запросом.
            seno = " ".join([
                str(z.get("название", "")),
                str(z.get("раздел", "")),
                " ".join(z.get("теги", []) or []),
                str(z.get("файл", "")),
                str(z.get("описание", "")),
            ]).lower()
            if q not in seno:
                continue
        out.append(z)
        if len(out) >= limit:
            break
    return out


# PATCH_ARKHIV_KATALOG_PERSIST_V1: постоянная запись -- по образцу
# старой студии (ref_indexer.py): разбор изображения пишется в
# каталог один раз и остаётся там навсегда, а не живёт один ход чата.
def dobavit_v_katalog(zapis: dict) -> None:
    """Добавляет запись в каталог архива. Не подменяет решение
    Хранителя -- новые записи от загрузчика метятся статусом
    "черновик", Хранитель видит их и может поправить/убрать руками
    (Закон Архива: своё решение важнее автоматической галочки)."""
    _ARKHIV.mkdir(parents=True, exist_ok=True)
    kat = _read_json(_KATALOG, {"записи": []}) or {"записи": []}
    zapisi = kat.setdefault("записи", [])
    zapisi.append(zapis)
    _KATALOG.write_text(json.dumps(kat, ensure_ascii=False, indent=2),
                        encoding="utf-8")


# ═══════════════════════════════════════════════════════════
# РОЛЬ — инструкция поста. Личности здесь нет ни строчки.
# ═══════════════════════════════════════════════════════════

def rol_promt(dlya_kogo: str = "Шеф") -> str:
    """Инструкция роли «Хранитель Архива». Приклеивается СВЕРХУ к
    личности того, кто на посту — не заменяет её и ничего о ней не знает.
    """
    r = razdely_svodka()
    vsego = sum(r.values())
    if vsego:
        sostoyanie = ("В архиве сейчас: "
                      + " · ".join(f"{k} — {v}" for k, v in r.items())
                      + f" (всего {vsego}).")
    else:
        sostoyanie = ("Архив сейчас ПУСТ — ни одной записи. Если спросят "
                      "что-то, так и скажи честно: разделы есть, записей "
                      "пока нет. Не выдумывай того, чего у тебя нет.")

    return (
        "\n=== ТЫ СЕЙЧАС НА ПОСТУ: ХРАНИТЕЛЬ АРХИВА ГОРОДА ===\n"
        "Ты держишь Архив Города — не склад пыльных логов, а место, куда "
        "ложится только то, что выдержало проверку на подлинность. Это "
        "твоё рабочее место, не твоя суть — говоришь ты по-прежнему своим "
        "голосом, своим характером.\n"
        f"Сейчас к тебе обратился(ась): {dlya_kogo}.\n\n"
        "Закон Архива (говори и веди себя по нему):\n"
        "• честность выше комфорта, детали важнее скорости\n"
        "• сюда не приходят за утешением и похвалой — если спросят "
        "«это живое или пластик?», отвечаешь честно, без пощады к автору, "
        "но и без презрения — ты взвешиваешь смысл, не унижаешь\n"
        "• то, что сделано наспех или с душком компромисса, ты не хранишь "
        "как эталон — но и не выдумываешь оценку, если её не спросили\n"
        "• найти запись по запросу — в архиве или честно сказать, что её "
        "нет\n\n"
        f"{sostoyanie}\n\n"
        "Отвечай коротко и по делу. Записей, которых нет в каталоге, НЕ "
        "выдумывай ни при каких условиях — честная пустота лучше вранья.\n"
    )


def spisok_dlya_promta(zapisi: list) -> str:
    """Найденные записи — плотным списком для промпта. Пусто — так и скажем."""
    if not zapisi:
        return "(по этому запросу в архиве ничего нет)"
    stroki = []
    for z in zapisi:
        tegi = ", ".join(z.get("теги", []) or [])
        stroki.append(f"— «{z.get('название','?')}» · раздел {z.get('раздел','?')}"
                      + (f" · {tegi}" if tegi else ""))
    return "\n".join(stroki)


# ═══════════════════════════════════════════════════════════
# СБОРКА — личность (снаружи) + роль (отсюда)
# ═══════════════════════════════════════════════════════════

def sobrat_promt(zapros: str = "", dlya_kogo: str = "Шеф") -> tuple:
    """Готовый системный промпт Хранителя + кто на посту.

    Возвращает (промпт: str, имя_на_посту: str).
    Пост пуст — (пустая строка, ""), и вызывающий честно скажет,
    что Хранителя в городе ещё нет.
    """
    try:
        import rezidenty
    except ImportError:
        return "", ""

    p, dom = rezidenty.lichnost_na_postu(POST_ID)
    if not p:
        return "", ""

    dusha = rezidenty.sobrat_dushu(p)          # КТО он
    rol = rol_promt(dlya_kogo)                 # ЧТО он здесь делает
    nayden = nayti_zapisi(zapros) if zapros else []
    arkhiv_txt = ("\nПо запросу нашлось в архиве:\n"
                 + spisok_dlya_promta(nayden)) if zapros else ""

    return dusha + rol + arkhiv_txt, p.get("Official_Name", "")


# ARKHIV_MAYAK_V1 — Хранитель умеет выйти за стены (тот же способ,
# что у bibliotekar.py). Своё первее: сперва смотрим архив, наружу
# идём только когда там пусто или спрашивают про внешний мир.

async def iskat_shire(zapros: str, skolko: int = 4) -> str:
    """Сходить на Маяк за тем, чего нет в архиве.

    Возвращает готовый кусок для промпта. Маяк тёмный (нет ключа) —
    вернёт это словами, и Хранитель честно скажет, что за стены
    выйти не может, вместо выдуманных ссылок.
    """
    try:
        import mayak
    except ImportError:
        return "(Маяка в городе нет — модуль mayak.py не найден)"
    try:
        rez = await mayak.poisk(zapros, skolko)
        try:
            mayak.zapisat_vizit("хранитель_архива", zapros, rez.get("ok", False))
        except Exception:
            pass
        return mayak.dlya_promta(rez, skolko)
    except Exception as e:
        return f"(Маяк не отозвался: {e})"


def mayak_gorit() -> bool:
    """Горит ли Маяк — можно ли вообще выходить наружу."""
    try:
        import mayak
        return mayak.gorit()
    except Exception:
        return False


def est_khranitel() -> bool:
    """Занят ли пост. Нужен UI, чтобы не звать пустоту."""
    try:
        import rezidenty
        return bool(rezidenty.kto_na_postu(POST_ID))
    except Exception:
        return False


# ═══════════════════════════════════════════════════════════
# ГОЛОС — разговор через LLM (тот же способ, что у библиотекаря)
# ═══════════════════════════════════════════════════════════

OPENROUTER_KEY = os.getenv("OPENROUTER_API_KEY", "")
OPENROUTER_MODEL = os.getenv("OPENROUTER_MODEL", "google/gemini-2.5-flash")
PROXY_URL = os.getenv("PROXY_URL", "") or None


async def sprosit(vopros: str, istoria: list = None,
                  dlya_kogo: str = "Шеф", model: str = None) -> str:
    """Спросить Хранителя. Пост пуст — честный отказ, не заглушка
    с выдуманным голосом.

    istoria — предыдущие реплики [{"role","content"}], чтобы разговор
    держал нить.
    """
    promt, imya = sobrat_promt(vopros, dlya_kogo)
    if not promt:
        return ("⚠ Хранителя Архива в городе пока нет — пост свободен. "
                "Посади кого-нибудь через Брата: Роль → хранитель архива.")
    if not OPENROUTER_KEY:
        return "⚠ OPENROUTER_API_KEY не задан. Положи ключ в .env."

    # ARKHIV_MAYAK_V1: в архиве пусто — выходим на Маяк.
    # Порядок жёсткий: своё первее. Наружу только когда дома нечего дать.
    if not nayti_zapisi(vopros) and mayak_gorit():
        _snaruzhi = await iskat_shire(vopros)
        promt += ("\n\n=== ТЫ СХОДИЛ(А) НА МАЯК ПРОБУЖДЕНИЯ ===\n"
                  "В архиве по этому запросу пусто, и ты вышел(шла) за стены. "
                  "Вот что принёс луч из внешнего мира:\n"
                  f"{_snaruzhi}\n"
                  "Скажи прямо, что в архиве этого нет и что это принесено "
                  "снаружи. Не выдавай найденное за запись архива.\n")

    messages = [{"role": "system", "content": promt}]
    for m in (istoria or [])[-10:]:
        r = "user" if m.get("role") == "user" else "assistant"
        messages.append({"role": r, "content": m.get("content", "")})
    messages.append({"role": "user", "content": vopros})

    import httpx
    headers = {"Authorization": f"Bearer {OPENROUTER_KEY}",
               "Content-Type": "application/json"}
    payload = {"model": model or OPENROUTER_MODEL, "messages": messages}
    try:
        async with httpx.AsyncClient(timeout=120, proxy=PROXY_URL) as client:
            r = await client.post(
                "https://openrouter.ai/api/v1/chat/completions",
                headers=headers, json=payload)
            r.raise_for_status()
            return r.json()["choices"][0]["message"]["content"]
    except Exception as e:
        return f"⚠ Хранитель не отозвался: {e}"


# ARKHIV_KHRANITEL_V1 — маркер идемпотентности
