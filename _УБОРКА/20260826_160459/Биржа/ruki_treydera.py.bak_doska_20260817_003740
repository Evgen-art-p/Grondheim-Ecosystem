    try:
        import sys as _s
        from pathlib import Path as _P
        _g = str(_P(__file__).resolve().parent.parent / "ГОРОД")
        if _g not in _s.path:
            _s.path.insert(0, _g)
        import ruka_mayaka
        return ruka_mayaka.shema()
    except Exception:
        return []          # Маяка нет — руки просто не будет


