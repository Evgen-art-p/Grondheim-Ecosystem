            ui.label(f"ляжет рядом как  {budet}").style(
                "color:rgba(139,233,253,0.7); font-size:0.74rem; "
                "font-family:monospace; margin-top:4px;")

            def _kopiya():
                novoe, _n = _imya_kopii(Path(c["папка"]))
