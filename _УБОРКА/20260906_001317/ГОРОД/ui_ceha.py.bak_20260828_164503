                ui.label(f'{s["слот"]}  ·  {s["роль"]}  ·  {kto}{mozg}').style(
                    f"color:{cvet}; font-size:0.78rem; "
                    f"font-family:monospace;")

            # MENEDZHER_KARTRIDZHEY_V1: контора не сменная деталь —
            # ни копий, ни вынимания. Показываем почему, а не прячем.
