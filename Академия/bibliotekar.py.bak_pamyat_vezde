# -*- coding: utf-8 -*-
# AKADEMIA_BIBLIOTEKAR_V1 — рабочий движок поста «библиотекарь»
"""
БИБЛИОТЕКАРЬ АКАДЕМИИ · рабочий движок

Это РОЛЬ, не человек. Файл не знает и не хочет знать, кто на посту.
Личность приходит извне — из паспорта того, кого Брат туда посадил
(ГОРОД/rezidenty.py -> lichnost_na_postu). Посадишь другого — движок
тот же, голос другой. Это прямой закон Шефа: личность не прикручена
к роли.

Что умеет библиотекарь:
  • искать книги на полках — по названию, полке, тегам
  • сказать, что стоит на полках и чего нет
  • подобрать книгу жителю по его натуре (тот же привратник, что в
    старом городе: тяжёлую книгу не даём тому, кто не дорос)
  • говорить в чате — с Шефом и с жителями, в роли библиотекаря

Полки читаются с диска, каталог тот же, что наполняет кабинет
Академии (GRONDHEIM_CITY/Академия/библиотека/каталог.json). Второго
реестра нет.

ЧЕГО ЗДЕСЬ НЕТ ЧЕСТНО: движок не выдумывает книг, которых нет на
полке. Полка пуста — так и скажет. Пустая полка честнее вранья.

`шесть·проверено·до·корня`
"""
import json
import os
import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent     # Академия/
_REPO = _HERE.parent                         # корень репо
for _p in (_REPO, _REPO / "ГОРОД", _HERE):
    if str(_p) not in sys.path:
        sys.path.insert(0, str(_p))

POST_ID = "bibliotekar"                      # id поста в реестре города

_BIBLIO = _REPO / "GRONDHEIM_CITY" / "Академия" / "библиотека"
_KATALOG = _BIBLIO / "каталог.json"

# Глубина книги против натуры — тот же привратник, что в старом городе.
# Порог берётся по «весу» жителя: упрямство + свобода + вкус.
GLUBINA_POROG = {
    "basic":   0.0,    # простая — открыта всем
    "applied": 0.40,   # прикладная — нужен минимальный вес
    "deep":    0.65,   # глубокая — не даётся тому, кто не дорос
}


# ═══════════════════════════════════════════════════════════
# ПОЛКИ
# ═══════════════════════════════════════════════════════════

def _read_json(p: Path, default=None):
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return default


def vse_knigi() -> list:
    """Все книги каталога. Каталога нет — пустой список, не падаем."""
    k = _read_json(_KATALOG, {}) or {}
    return k.get("книги", []) or []


def polki() -> dict:
    """Сколько книг на какой полке. {полка: число}."""
    out = {}
    for b in vse_knigi():
        p = b.get("полка", "прочее")
        out[p] = out.get(p, 0) + 1
    return out


def nayti_knigi(zapros: str, polka: str = "", limit: int = 8) -> list:
    """Поиск книг по названию, тегам и полке. Пустой запрос — вернёт
    первые из выбранной полки (или вообще первые).

    Ищем честно: подстрокой, без выдумок. Не нашли — пустой список,
    и вызывающий скажет об этом прямо.
    """
    q = (zapros or "").strip().lower()
    out = []
    for b in vse_knigi():
        if polka and b.get("полка", "") != polka:
            continue
        if q:
            seno = " ".join([
                str(b.get("название", "")),
                str(b.get("полка", "")),
                " ".join(b.get("теги", []) or []),
                str(b.get("файл", "")),
            ]).lower()
            if q not in seno:
                continue
        out.append(b)
        if len(out) >= limit:
            break
    return out


def _ves_natury(dna: dict) -> float:
    """Вес жителя для допуска к глубине. Не «умнее/глупее» — а
    насколько он готов спорить с книгой, а не глотать её целиком."""
    if not isinstance(dna, dict) or not dna:
        return 0.5
    try:
        u = float(dna.get("Stubbornness", 0.5) or 0.5)
        a = float(dna.get("Autonomy_Level", 0.5) or 0.5)
        e = float(dna.get("Aesthetic_Threshold", 0.5) or 0.5)
    except (TypeError, ValueError):
        return 0.5
    return round((u + a + e) / 3.0, 3)


def podobrat_knigu(dna: dict, polka: str = "", zapros: str = "") -> dict:
    """Подбор книги под натуру. Возвращает
    {"книга": dict|None, "вес": float, "отказано": [названия]}.

    Привратник: книга глубже, чем вес жителя, ФИЗИЧЕСКИ не выдаётся —
    не «дали и не понял», а не дали. Дорос — полка открылась.
    """
    ves = _ves_natury(dna)
    kandidaty = nayti_knigi(zapros, polka, limit=50)
    otkazano = []
    podoshla = None
    for b in kandidaty:
        g = (b.get("глубина", "basic") or "basic").lower()
        porog = GLUBINA_POROG.get(g, 0.0)
        if ves < porog:
            otkazano.append(b.get("название", "?"))
            continue
        if podoshla is None:
            podoshla = b
    return {"книга": podoshla, "вес": ves, "отказано": otkazano}


# ═══════════════════════════════════════════════════════════
# РОЛЬ — инструкция поста. Личности здесь нет ни строчки.
# ═══════════════════════════════════════════════════════════

def rol_promt(dlya_kogo: str = "Шеф") -> str:
    """Инструкция роли «библиотекарь». Приклеивается СВЕРХУ к личности
    того, кто на посту — не заменяет её и ничего о ней не знает.

    dlya_kogo — с кем сейчас говорит: «Шеф» или имя жителя.
    """
    p = polki()
    vsego = sum(p.values())
    if vsego:
        sostoyanie = ("На полках сейчас: "
                      + " · ".join(f"{k} — {v}" for k, v in p.items())
                      + f" (всего {vsego}).")
    else:
        sostoyanie = ("Полки сейчас ПУСТЫ — ни одной книги. Если спросят "
                      "книгу, так и скажи честно: полок много, книг пока нет. "
                      "Не выдумывай названий, которых у тебя нет.")

    return (
        "\n=== ТЫ СЕЙЧАС НА РАБОТЕ: БИБЛИОТЕКАРЬ АКАДЕМИИ ===\n"
        "Ты держишь библиотеку Замка Сов. Это твоё рабочее место, не твоя "
        "суть — говоришь ты по-прежнему своим голосом, своим характером.\n"
        f"Сейчас к тебе обратился(ась): {dlya_kogo}.\n\n"
        "Твоё дело:\n"
        "• найти книгу по запросу — на полке или честно сказать, что её нет\n"
        "• подсказать, с чего начать, если человек не знает, что искать\n"
        "• не выдавать тяжёлую книгу тому, кто до неё не дорос натурой — "
        "это не спесь, а забота: рано взятая книга ломает, а не учит\n"
        "• помогать и Шефу, и жителям — любому, кто пришёл\n\n"
        f"{sostoyanie}\n\n"
        "Отвечай коротко и по делу. Книг, которых нет в списке, НЕ выдумывай "
        "ни при каких условиях — лучше признать пустоту полки.\n"
    )


def spisok_dlya_promta(knigi: list) -> str:
    """Найденные книги — плотным списком для промпта. Пусто — так и скажем."""
    if not knigi:
        return "(по этому запросу на полках ничего нет)"
    stroki = []
    for b in knigi:
        g = b.get("глубина", "basic")
        tegi = ", ".join(b.get("теги", []) or [])
        stroki.append(f"— «{b.get('название','?')}» · полка {b.get('полка','?')}"
                      f" · глубина {g}" + (f" · {tegi}" if tegi else ""))
    return "\n".join(stroki)


# ═══════════════════════════════════════════════════════════
# СБОРКА — личность (снаружи) + роль (отсюда)
# ═══════════════════════════════════════════════════════════

def sobrat_promt(zapros: str = "", dlya_kogo: str = "Шеф") -> tuple:
    """Готовый системный промпт библиотекаря + кто на посту.

    Возвращает (промпт: str, имя_на_посту: str).
    Пост пуст — (пустая строка, ""), и вызывающий честно скажет,
    что библиотекаря в городе ещё нет.

    ВОТ ЗДЕСЬ И ВИДНА РАЗВЯЗКА:
        душа  <- личность жителя (rezidenty.sobrat_dushu)
        роль  <- инструкция поста (rol_promt, отсюда)
    Две разные строки, склеенные в момент работы. Ни одна не знает
    про другую.
    """
    try:
        import rezidenty
    except ImportError:
        return "", ""

    p, dom = rezidenty.lichnost_na_postu(POST_ID)
    if not p:
        return "", ""

    dusha = rezidenty.sobrat_dushu(p)          # КТО он
    rol = rol_promt(dlya_kogo)                 # ЧТО он здесь делает
    nayden = nayti_knigi(zapros) if zapros else []
    polka_txt = ("\nПо запросу нашлось на полках:\n"
                 + spisok_dlya_promta(nayden)) if zapros else ""

    return dusha + rol + polka_txt, p.get("Official_Name", "")


# PATCH_GOROD_MAYAK_V1 — библиотекарь умеет выйти за стены
# Полки ВСЕГДА первее: сперва смотрим своё, наружу идём только когда
# на полке пусто или спрашивают про внешний мир. Маяк общегородской —
# библиотека им пользуется, но не владеет.

async def iskat_shire(zapros: str, skolko: int = 4) -> str:
    """Сходить на Маяк за тем, чего нет на полках.

    Возвращает готовый кусок для промпта. Маяк тёмный (нет ключа) —
    вернёт это словами, и библиотекарь честно скажет, что за стены
    выйти не может, вместо выдуманных ссылок.
    """
    try:
        import mayak
    except ImportError:
        return "(Маяка в городе нет — модуль ГОРОД/mayak.py не найден)"
    try:
        rez = await mayak.poisk(zapros, skolko)
        try:
            mayak.zapisat_vizit("библиотекарь", zapros, rez.get("ok", False))
        except Exception:
            pass
        return mayak.dlya_promta(rez, skolko)
    except Exception as e:
        return f"(Маяк не отозвался: {e})"


def mayak_gorit() -> bool:
    """Горит ли Маяк — можно ли вообще выходить наружу."""
    try:
        import mayak
        return mayak.gorit()
    except Exception:
        return False


def est_bibliotekar() -> bool:
    """Занят ли пост. Нужен UI, чтобы не звать пустоту."""
    try:
        import rezidenty
        return bool(rezidenty.kto_na_postu(POST_ID))
    except Exception:
        return False


# ═══════════════════════════════════════════════════════════
# ГОЛОС — разговор через LLM (тот же способ, что у жителя)
# ═══════════════════════════════════════════════════════════

OPENROUTER_KEY = os.getenv("OPENROUTER_API_KEY", "")
OPENROUTER_MODEL = os.getenv("OPENROUTER_MODEL", "google/gemini-2.5-flash")
PROXY_URL = os.getenv("PROXY_URL", "") or None


async def sprosit(vopros: str, istoria: list = None,
                  dlya_kogo: str = "Шеф", model: str = None) -> str:
    """Спросить библиотекаря. Пост пуст — честный отказ, не заглушка
    с выдуманным голосом.

    istoria — предыдущие реплики [{"role","content"}], чтобы разговор
    держал нить.
    """
    promt, imya = sobrat_promt(vopros, dlya_kogo)
    if not promt:
        return ("⚠ Библиотекаря в городе пока нет — пост свободен. "
                "Посади кого-нибудь через Брата: Роль → библиотекарь.")
    if not OPENROUTER_KEY:
        return "⚠ OPENROUTER_API_KEY не задан. Положи ключ в .env."

    # PATCH_GOROD_MAYAK_V1: на полках пусто — выходим на Маяк.
    # Порядок жёсткий: СВОЁ первее. Наружу только когда дома нечего дать.
    if not nayti_knigi(vopros) and mayak_gorit():
        _snaruzhi = await iskat_shire(vopros)
        promt += ("\n\n=== ТЫ СХОДИЛ(А) НА МАЯК ПРОБУЖДЕНИЯ ===\n"
                  "На полках по этому запросу пусто, и ты вышел(шла) за стены. "
                  "Вот что принёс луч из внешнего мира:\n"
                  f"{_snaruzhi}\n"
                  "Скажи прямо, что на полках этого нет и что это принесено "
                  "снаружи. Не выдавай найденное за книгу библиотеки.\n")

    messages = [{"role": "system", "content": promt}]
    for m in (istoria or [])[-10:]:
        r = "user" if m.get("role") == "user" else "assistant"
        messages.append({"role": r, "content": m.get("content", "")})
    messages.append({"role": "user", "content": vopros})

    import httpx
    headers = {"Authorization": f"Bearer {OPENROUTER_KEY}",
               "Content-Type": "application/json"}
    payload = {"model": model or OPENROUTER_MODEL, "messages": messages}
    try:
        async with httpx.AsyncClient(timeout=120, proxy=PROXY_URL) as client:
            r = await client.post(
                "https://openrouter.ai/api/v1/chat/completions",
                headers=headers, json=payload)
            r.raise_for_status()
            return r.json()["choices"][0]["message"]["content"]
    except Exception as e:
        return f"⚠ Библиотекарь не отозвался: {e}"


